# Created by 小杜 on 2026/08

"""面板一键更新（热更新）：检查 → 下载 → RSA 签名校验 → 备份 → 应用 → 自动重启。

更新包结构（由 tools/build_update_pkg.py 生成，上传到官网 /update/ 目录）：
  latest.json   {version, notes, url, size, manifest: {version, files:{path:sha256}, signature}}
  rt-panel-update-<version>.zip   含所有受保护文件（相对面板根目录）
"""
import base64
import hashlib
import json
import os
import shutil
import sys
import threading
import time
import urllib.request
import zipfile

from fastapi import APIRouter, Depends, HTTPException, Request

from ..audit import audit
from ..auth import get_client_ip, require_perm
from ..binding import server_url
from ..config import BACKUP_DIR, BASE_DIR, DATA_DIR, PANEL_VERSION, TMP_DIR

router = APIRouter(prefix='/api/update', tags=['update'])

# 面板根目录（backend/ 的上一级）。
# 注意：__file__ 是 <ROOT>/backend/app/routers/update.py，dirname 三次只到 <ROOT>/backend，
# 会少算一层（曾导致更新写到 <ROOT>/backend/backend/… 且重启失败，属于 B-01）。
# 这里统一从 config.BASE_DIR（= <ROOT>/backend）取上一级，别再手算 dirname。
PANEL_ROOT = os.path.dirname(BASE_DIR)
PUBLIC_KEY_PATH = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                               'license_public.pem')

UPDATE_STATE = {'busy': False, 'log': [], 'last_result': None}


def _log(msg: str):
    UPDATE_STATE['log'].append(f'[{time.strftime("%H:%M:%S")}] {msg}')
    UPDATE_STATE['log'] = UPDATE_STATE['log'][-100:]


def _public_key():
    from cryptography.hazmat.primitives import serialization
    with open(PUBLIC_KEY_PATH, 'rb') as f:
        return serialization.load_pem_public_key(f.read())


def _canonical(obj: dict) -> bytes:
    return json.dumps(obj, sort_keys=True, separators=(',', ':'),
                      ensure_ascii=False).encode('utf-8')


def _signed_payload(manifest: dict) -> dict:
    """签名载荷 = 清单里除 signature 外的全部字段。

    历史坑（P-10）：旧实现只签 `files`，于是顶层 `version`/`url`/`size` 都在签名之外——
    改个版本号配一个老包就能强制降级，`url` 还能指向任意地址做 SSRF/磁盘填充。
    """
    return {k: v for k, v in manifest.items() if k != 'signature'}


def _verify_manifest(manifest: dict) -> bool:
    """校验更新清单的 RSA 签名（覆盖 version/url/size/files 等全部字段）。"""
    try:
        from cryptography.hazmat.primitives import hashes
        from cryptography.hazmat.primitives.asymmetric import padding
        sig = base64.b64decode(manifest.get('signature', ''))
        _public_key().verify(sig, _canonical(_signed_payload(manifest)),
                             padding.PKCS1v15(), hashes.SHA256())
    except Exception:
        return False
    # 关键字段必须存在且类型正确（缺失即视为清单不完整）
    if not isinstance(manifest.get('files'), dict) or not manifest['files']:
        return False
    return bool(manifest.get('version'))


def _ver_tuple(v: str):
    """把版本号拆成可比较的元组：数字段 + 预发布标记（rc < 正式）。"""
    import re as _re
    text = str(v or '').strip().lower()
    m = _re.match(r'^(\d+(?:\.\d+)*)(?:[-_.]?([a-z]+)\.?(\d*))?$', text)
    if not m:
        return ((0,), 0, ())
    nums = tuple(int(x) for x in m.group(1).split('.'))
    tag = m.group(2) or ''
    tag_num = int(m.group(3) or 0)
    # 预发布（带字母后缀）排在正式版之前
    pre = 0 if not tag else -1
    return (nums, pre, (tag, tag_num))


def _ver_gt(newer: str, current: str) -> bool:
    """语义化比较（取代字符串比较，避免 '9' > '10' 与预发布误判）。"""
    try:
        return _ver_tuple(newer) > _ver_tuple(current)
    except Exception:
        return False


def _hash_file(path: str) -> str:
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for chunk in iter(lambda: f.read(65536), b''):
            h.update(chunk)
    return h.hexdigest()


@router.get('/check')
def check(user: dict = Depends(require_perm('settings:view'))):
    """从官网获取最新版本信息（机器感知：优先本机定向推送，其次全局推送）。"""
    from ..hardware import machine_id
    mid = machine_id()
    info = None
    url = f'{server_url()}/api/v1/update/check?machine_id={mid}&version={PANEL_VERSION}'
    try:
        req = urllib.request.Request(url, headers={'User-Agent': 'RTPanel-Updater/1.0'})
        with urllib.request.urlopen(req, timeout=15) as resp:
            info = json.loads(resp.read().decode('utf-8'))
    except Exception:
        info = None
    if not info or not info.get('manifest'):
        # 回退：静态清单（官网为老版本时的兼容路径）
        static_url = f'{server_url()}/update/latest.json'
        try:
            req = urllib.request.Request(static_url, headers={'User-Agent': 'RTPanel-Updater/1.0'})
            with urllib.request.urlopen(req, timeout=15) as resp:
                info = json.loads(resp.read().decode('utf-8'))
        except Exception as e:
            raise HTTPException(status_code=502, detail=f'无法连接更新服务器: {e}')
    if not info.get('manifest') or not _verify_manifest(info['manifest']):
        raise HTTPException(status_code=502, detail='更新清单签名校验失败（服务器数据异常或已被篡改）')
    manifest = info.get('manifest') or {}
    top_version = str(info.get('version', '')).strip()
    man_version = str(manifest.get('version', '')).strip()
    if man_version and top_version and man_version != top_version:
        raise HTTPException(status_code=502, detail='更新清单版本号不一致（顶层与 manifest 不符），已拒绝')
    min_version = str(manifest.get('min_version', '') or '').strip()
    if min_version and _ver_gt(min_version, PANEL_VERSION):
        raise HTTPException(status_code=502,
                            detail=f'该更新要求面板版本不低于 {min_version}，请先升级到中间版本')
    info['current_version'] = PANEL_VERSION
    info['has_update'] = _ver_gt(top_version, PANEL_VERSION)
    return info


@router.get('/status')
def status(user: dict = Depends(require_perm('settings:view'))):
    return {'busy': UPDATE_STATE['busy'], 'log': UPDATE_STATE['log'],
            'last_result': UPDATE_STATE['last_result'],
            'integrity_diff': UPDATE_STATE.get('integrity_diff') or [],
            'current_version': PANEL_VERSION}


@router.post('/apply')
def apply(body: dict, request: Request, user: dict = Depends(require_perm('settings:manage'))):
    """应用更新（后台线程执行，完成后自动重启面板）。"""
    if UPDATE_STATE['busy']:
        raise HTTPException(status_code=409, detail='已有更新任务进行中')
    try:
        info = check(user)
    except HTTPException as e:
        raise e
    if not info.get('has_update'):
        raise HTTPException(status_code=400, detail='已是最新版本')
    if str(info.get('version', '')) == PANEL_VERSION:
        raise HTTPException(status_code=400, detail='已是最新版本')
    UPDATE_STATE['busy'] = True
    UPDATE_STATE['last_result'] = None
    UPDATE_STATE['log'] = []
    audit(user['username'], get_client_ip(request), 'update_apply',
          f'开始更新到 v{info.get("version")}', 'warning')

    def _do():
        try:
            _apply_impl(info)
            _ack_push(info)
            UPDATE_STATE['last_result'] = {'ok': True, 'version': info.get('version')}
        except Exception as e:
            UPDATE_STATE['last_result'] = {'ok': False, 'error': str(e)}
            _log(f'更新失败: {e}')
        finally:
            UPDATE_STATE['busy'] = False

    threading.Thread(target=_do, daemon=True).start()
    return {'ok': True, 'msg': '更新任务已启动', 'version': info.get('version')}


def _ack_push(info: dict):
    """推送回报：告诉官网本机已应用此版本（不再重复推送）。"""
    try:
        from ..hardware import machine_id
        payload = json.dumps({'machine_id': machine_id(),
                              'version': info.get('version', ''),
                              'push_id': info.get('push_id')}).encode('utf-8')
        req = urllib.request.Request(f'{server_url()}/api/v1/update/ack',
                                     data=payload,
                                     headers={'Content-Type': 'application/json',
                                              'User-Agent': 'RTPanel-Updater/1.0'})
        urllib.request.urlopen(req, timeout=10).read()
    except Exception:
        pass


MAX_PKG_BYTES = 80 * 1024 * 1024   # 更新包体积上限


def _assert_panel_root():
    """应用前必须确认 PANEL_ROOT 真的是面板根目录（B-01：算错一层会写到不存在的目录树）。"""
    run_py = os.path.join(PANEL_ROOT, 'backend', 'run.py')
    if not os.path.isfile(run_py):
        raise RuntimeError(f'面板根目录判定异常（找不到 {run_py}），已中止更新')
    return run_py


def _apply_impl(info: dict):
    manifest = info['manifest']
    files = manifest.get('files', {})
    _assert_panel_root()
    _log(f'开始更新 v{info.get("version")}（{len(files)} 个文件）')
    _log(f'面板根目录: {PANEL_ROOT}')

    # 1. 下载更新包（只允许官网同源路径 + 体积上限，防盲 SSRF 与磁盘填充）
    raw_url = str(info.get('url', '')).strip()
    if not raw_url:
        raise RuntimeError('更新清单缺少下载地址')
    base = server_url().rstrip('/')
    if raw_url.startswith('http'):
        from urllib.parse import urlparse as _urlparse
        if _urlparse(raw_url).netloc != _urlparse(base).netloc:
            raise RuntimeError(f'更新包地址不是官网同源地址，已拒绝：{raw_url}')
        url = raw_url
    else:
        url = base + '/' + raw_url.lstrip('/')
    zip_path = os.path.join(TMP_DIR, 'rt-panel-update.zip')
    _log(f'下载更新包: {url}')
    req = urllib.request.Request(url, headers={'User-Agent': 'RTPanel-Updater/1.0'})
    written = 0
    with urllib.request.urlopen(req, timeout=300) as resp, open(zip_path, 'wb') as f:
        while True:
            chunk = resp.read(65536)
            if not chunk:
                break
            written += len(chunk)
            if written > MAX_PKG_BYTES:
                f.close()
                try:
                    os.remove(zip_path)
                except Exception:
                    pass
                raise RuntimeError('更新包体积超出上限，已中止下载')
            f.write(chunk)
    _log(f'下载完成（{written // 1024} KB）')

    # 2. 解压并校验每个文件哈希
    extract_dir = os.path.join(TMP_DIR, 'update_extract')
    if os.path.isdir(extract_dir):
        shutil.rmtree(extract_dir)
    os.makedirs(extract_dir)
    with zipfile.ZipFile(zip_path) as zf:
        # 防 zip 路径穿越：用 realpath + commonpath 判定（原 startswith('/') 漏掉 Windows 的 C:\ 绝对路径）
        root_real = os.path.realpath(extract_dir)
        for n in zf.namelist():
            if not n or n.endswith('/'):
                continue
            target = os.path.realpath(os.path.join(extract_dir, n.replace('\\', '/')))
            try:
                inside = os.path.commonpath([root_real, target]) == root_real
            except ValueError:
                inside = False
            if not inside:
                raise RuntimeError(f'更新包包含非法路径，已中止: {n}')
        zf.extractall(extract_dir)
    for rel, want in files.items():
        fp = os.path.join(extract_dir, rel.replace('/', os.sep))
        if not os.path.isfile(fp) or _hash_file(fp) != want:
            raise RuntimeError(f'文件校验失败（可能被篡改）: {rel}')
    _log('签名与文件哈希校验通过')

    # 3. 备份当前文件
    backup_path = os.path.join(BACKUP_DIR, f'update_backup_{time.strftime("%Y%m%d_%H%M%S")}.zip')
    _log(f'备份当前版本到 {os.path.basename(backup_path)}')
    with zipfile.ZipFile(backup_path, 'w', zipfile.ZIP_DEFLATED) as bz:
        for rel in files:
            fp = os.path.join(PANEL_ROOT, rel.replace('/', os.sep))
            if os.path.isfile(fp):
                bz.write(fp, rel)

    # 4. 应用新文件（保护 data/ 与 .deps 不被覆盖——manifest 不包含它们）
    for rel in files:
        src = os.path.join(extract_dir, rel.replace('/', os.sep))
        dst = os.path.join(PANEL_ROOT, rel.replace('/', os.sep))
        if not os.path.isfile(src):
            continue
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy2(src, dst)
    _log('文件替换完成')

    # 5. 清理并重启
    try:
        os.remove(zip_path)
        shutil.rmtree(extract_dir, ignore_errors=True)
    except Exception:
        pass
    _log('重启面板以生效…')

    # 更新后立即做一次完整性自检，把差异交给前端
    try:
        from .. import integrity
        report = integrity.check_project()
        diff = report.get('changed') or report.get('diff') or []
        if diff:
            _log(f'完整性自检发现 {len(diff)} 处与签名清单不一致，请在安全中心复核')
            UPDATE_STATE['integrity_diff'] = diff[:50]
        else:
            _log('完整性自检通过')
    except Exception as e:
        _log(f'完整性自检不可用: {e}')

    def _restart():
        time.sleep(1.5)
        try:
            os.execv(sys.executable, [sys.executable, os.path.join(PANEL_ROOT, 'backend', 'run.py')])
        except Exception as e:
            # 不能吞：重启失败意味着新代码没生效，必须让前端看到失败
            _log(f'重启失败，新版本未生效: {e}')
            UPDATE_STATE['last_result'] = {'ok': False, 'error': f'重启失败: {e}',
                                           'version': info.get('version')}

    threading.Thread(target=_restart, daemon=True).start()


@router.post('/rollback')
def rollback(request: Request, user: dict = Depends(require_perm('settings:manage'))):
    """回滚到最近一次更新前的版本。"""
    backups = sorted(
        [f for f in os.listdir(BACKUP_DIR) if f.startswith('update_backup_')],
        reverse=True)
    if not backups:
        raise HTTPException(status_code=404, detail='没有可用的更新备份')
    backup_path = os.path.join(BACKUP_DIR, backups[0])
    audit(user['username'], get_client_ip(request), 'update_rollback',
          f'回滚到更新前版本（{backups[0]}）', 'warning')
    try:
        # 复用文件管理里的安全解压（成员名校验 + 拒符号链接 + 体积上限），不要直接 extractall
        from .files import _archive_target  # noqa: F401  （保持与 files 相同的校验口径）
        from .files import _extract_zip_safely
        _extract_zip_safely(backup_path, PANEL_ROOT)
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=f'回滚失败: {e}')

    def _restart():
        time.sleep(1.5)
        try:
            os.execv(sys.executable, [sys.executable, os.path.join(PANEL_ROOT, 'backend', 'run.py')])
        except Exception:
            pass

    threading.Thread(target=_restart, daemon=True).start()
    return {'ok': True, 'msg': '已回滚，面板即将重启'}
